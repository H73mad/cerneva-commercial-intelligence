      <column caption="Opportunity Id" datatype="string" name="[opportunity_id]" role="dimension" type="nominal" />
      <column caption="Deal Stage" datatype="string" name="[deal_stage]" role="dimension" type="nominal" />
      <column caption="Engage Date" datatype="date" name="[engage_date]" role="dimension" type="ordinal" />
      <column caption="Close Date" datatype="date" name="[close_date]" role="dimension" type="ordinal" />
      <column caption="Close Month" datatype="string" name="[close_month]" role="dimension" type="ordinal" />
      <column caption="Sales Agent" datatype="string" name="[sales_agent]" role="dimension" type="nominal" />
      <column caption="Manager" datatype="string" name="[manager]" role="dimension" type="nominal" />
      <column caption="Regional Office" datatype="string" name="[regional_office]" role="dimension" type="nominal" />
      <column caption="Product" datatype="string" name="[product]" role="dimension" type="nominal" />
      <column caption="Series" datatype="string" name="[series]" role="dimension" type="nominal" />
      <column caption="Sales Price" datatype="real" name="[sales_price]" role="measure" type="quantitative" />
      <column caption="Account" datatype="string" name="[account]" role="dimension" type="nominal" />
      <column caption="Sector" datatype="string" name="[sector]" role="dimension" type="nominal" />
      <column caption="Office Location" datatype="string" name="[office_location]" role="dimension" type="nominal" />
      <column caption="Account Revenue M" datatype="real" name="[account_revenue_m]" role="measure" type="quantitative" />
      <column caption="Employees" datatype="integer" name="[employees]" role="measure" type="quantitative" />
      <column caption="Is Closed" datatype="boolean" name="[is_closed]" role="dimension" type="nominal" />
      <column caption="Is Won" datatype="integer" name="[is_won]" role="measure" type="quantitative" />
      <column caption="Close Value" datatype="real" name="[close_value]" role="measure" type="quantitative" />
      <column caption="Sales Cycle Days" datatype="integer" name="[sales_cycle_days]" role="measure" type="quantitative" />
      <column caption="Discount Pct" datatype="real" name="[discount_pct]" role="measure" type="quantitative" />
      <column caption="Account Known" datatype="integer" name="[account_known]" role="measure" type="quantitative" />
      <column caption="Account Enriched" datatype="integer" name="[account_enriched]" role="measure" type="quantitative" />
      <column caption="Won Revenue" datatype="real" name="[Calculation_Won_Revenue]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [deal_stage] = &quot;Won&quot; THEN [close_value] END" />
      </column>
      <column caption="Closed Deal" datatype="integer" name="[Calculation_Closed_Deal]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [deal_stage] = &quot;Won&quot; OR [deal_stage] = &quot;Lost&quot; THEN 1 ELSE 0 END" />
      </column>
      <column caption="Win Rate" datatype="real" name="[Calculation_Win_Rate]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([is_won]) / SUM([Calculation_Closed_Deal])" />
      </column>
      <column caption="Open List Value" datatype="real" name="[Calculation_Open_Value]" role="measure" type="quantitative">
        <calculation class="tableau" formula="IF [deal_stage] = &quot;Prospecting&quot; OR [deal_stage] = &quot;Engaging&quot; THEN [sales_price] END" />
      </column>
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic">
        <semantic-values />
      </layout>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="KPI — Won Revenue">
      <table>
        <view>
          <datasources>
            <datasource caption="Cerneva Deal Detail" name="federated.cerneva" />
          </datasources>
          <datasource-dependencies datasource="federated.cerneva">
            <column caption="Deal Stage" datatype="string" name="[deal_stage]" role="dimension" type="nominal" />
            <column caption="Close Value" datatype="real" name="[close_value]" role="measure" type="quantitative" />
            <column caption="Won Revenue" datatype="real" name="[Calculation_Won_Revenue]" role="measure" type="quantitative">
              <calculation class="tableau" formula="IF [deal_stage] = &quot;Won&quot; THEN [close_value] END" />
            </column>
          </datasource-dependencies>
          <aggregation value="true" />
          <customized-tooltip>Cerneva · KPI — Won Revenue · #5B1738</customized-tooltip>
        </view>
        <style>
          <style-rule element="worksheet" />
        </style>
        <panes>
          <pane selection-relaxation-option="selection-relaxation-allow">
            <view>
              <breakdown value="auto" />
            </view>
            <mark class="Text" />
            <encodings>
              <text column="[federated.cerneva].[sum:Calculation_Won_Revenue:qk]" />
              <color column="[federated.cerneva].[none:deal_stage:nk]" />
            </encodings>
            <style />
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
    </worksheet>
